    }
  ],
  "paths": {
    "/users/me": {
      "get": {
        "operationId": "get_current_user",
        "summary": "Read your Apify account identity.",
        "parameters": [],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      }
    },
    "/actors": {
